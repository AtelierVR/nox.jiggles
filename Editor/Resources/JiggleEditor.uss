.curved-slider {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    height: 20px;
    min-height: 20px;
}

.curved-slider > .unity-base-slider__label {
    display: none;
    height: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.curved-slider > .unity-base-slider__drag-container {
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.curved-slider > .unity-base-slider__tracker {
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.curved-float-row {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    margin-left: 3px;
    margin-right: 0px;
    height: 20px;
    min-height: 20px;
}


.curved-float-row > .unity-label {
    min-width: 135px;
    width: 135px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
    padding-top: 0;
    padding-bottom: 0;
}

/* Constrain PropertyField labels to match curved-float-row label width */
.unity-inspector-element .unity-property-field__label {
    min-width: 140px;
    width: 140px;
}

.curve-toggle-btn {
    width: 28px;
    height: 18px;
    font-size: 10px;
    margin-left: 2px;
    margin-right: -2px;
    padding-top: 0;
    padding-bottom: 0;
    flex-shrink: 0;
}

.curved-field {
    margin-left: 140px;
    height: 20px;
    min-height: 20px;
}

#lbl-params-summary {
    padding: 4px 8px;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
    margin-bottom: 6px;
    -unity-font-style: italic;
}
